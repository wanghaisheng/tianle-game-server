  huRecur(_countMap, _jiang, caiCount = 0, lastTakeCardAndCaiShen, result, allSearch) {
    const countMap = _countMap;
    let jiang = _jiang;

    if (!result.huCards) {
      result.huCards = {useJiang: [], keZi: [], shunZi: [], gangZi: []}
      result.hu = false
      result.huType = 'pingHu'
