      if (this.huRecur(countMap, jiang, caiCount - 2, lastTakeCardAndCaiShen, result, allSearch)) {
        return true;             //   如果剩余的牌组合成功，和牌
      }
      if (i === Enums.bai) {
        result.sanCaiYiKe = false
      }

      keZi.splice(keZi.indexOf(i), 1)
      result.wuCai = true
      countMap[i] += 1;
