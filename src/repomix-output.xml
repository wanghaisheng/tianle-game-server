  canJoin(player) {
    if (!player) {
      return false
    }

    if (this.indexOf(player) >= 0) {
      return true
    }

    return this.players.filter(x => x != null).length + this.disconnected.length < this.capacity
  }

  async shuffleDataApply(payload) {
