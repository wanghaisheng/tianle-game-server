      result.wuCai = true
      keZi.splice(keZi.indexOf(CAISHEN_HOLDER), 1)
    }


    if (!_jiang && countMap[i] >= 2) {          //   如果之前没有将牌，且当前牌不少于2张
      jiang = true;
      countMap[i] -= 2;                                   //   减去2张牌
      useJiang.push(i)
      if (this.huRecur(countMap, jiang, caiCount, lastTakeCardAndCaiShen, result, allSearch)) {
        return true;             //   如果剩余的牌组合成功，和牌
      }
      jiang = false;
      useJiang.pop()
