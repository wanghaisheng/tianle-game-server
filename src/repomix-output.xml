  isGameOver(): boolean {
    const homeTeamCards = this.homeTeamPlayers().reduce((cards, p) => {
      return p.cards.length + cards
    }, 0)

    const awayTeamCards = this.awayTeamPlayers().reduce((cards, p) => {
      return p.cards.length + cards
