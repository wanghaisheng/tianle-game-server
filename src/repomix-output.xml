      }
      shunZi.splice(shunZi.lastIndexOf(i), 3)
      result.caiShenGuiWei = false
      result.guiWeiCount = originGuiWeiCount
      result.wuCai = true
      countMap[i]++;
    }


    //   无法全部组合，不和！
    return false;
  }
