        normalBomb.shift()
        return normalBomb;
      }
    }

    if (jockerCount >= 4) {
      normalBomb.push(cards.filter(c => c.type === CardType.Joker));
    }
      // if (cards.filter(c => c.point === 17).length === 2) {
      //   normalBomb.push([Enums.j1, Enums.j1, Enums.j2, Enums.j2])
