    let failFromList = [];
    let failIdList = [];
    if (!record) {
      console.warn("gang draw score record is exists");
      return ;
    }

    let winModel = await service.playerService.getPlayerModel(huPlayer._id.toString());
    let winBalance = 0;
    this.players.map((p) => {
      p.balance = 0;
    })

