        const contestIds = await redisClient.smembersAsync(`contest:${gn}`)
        for (const cId of contestIds) {
            const playerIds = await redisClient.smembersAsync(`contest:${cId}`)
            if (playerIds.findIndex(x => x === pId) >= 0) {
                result.contestId = cId
                result.gameType = gn
                return result
            }
        }
    }
}

