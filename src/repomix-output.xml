        }
        duiZi.push(CAISHEN_HOLDER)
      }

      duiZi = duiZi.concat(danZhang)
      //siZhang = siZhang.concat(sanZhang)
    }

    if (resMap.hu) {
      if (siZhang.length > 0) {
        resMap.haoQi = true
      }
      else {
        resMap.qiDui = true
      }
      resMap.huType = 'qiDui'
      resMap.huCards = {duiZi, siZhang, sanZhang}
    }

    return resMap.hu
  }
