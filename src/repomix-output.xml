  room: any
  // tslint:disable-next-line:variable-name
  __apiMap: any
  constructor(room) {
    this.room = room;
  }

  static getMethodName(method) {
    if (this.prototype.__apiMap && this.prototype.__apiMap.get(method)) {
      return this.prototype.__apiMap.get(method);
    }
    return '';
  }

