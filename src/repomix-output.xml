    }

    if (Enums.dong <= i) return false;

    //   顺牌组合，注意是从前往后组合！
    if (countMap[i] && i % 10 !== 8 && i % 10 !== 9 &&       //   排除数值为8和9的牌
      countMap[i + 1] && countMap[i + 2]) {            //   如果后面有连续两张牌
