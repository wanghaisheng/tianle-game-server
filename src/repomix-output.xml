        {prop: 'qiangGang', times: 2},
        {prop: 'pengPengHu', times: 2},
        {prop: 'qiDui', times: 2},
        {prop: 'haoQi', times: 4},
      ]
    }
    if(rule.hzlz_option === 'qidui'){
      return [
        {prop: 'qiDui', times: 2},
        {prop: 'haoQi', times: 4},
      ]
    }
    return []
  },

  // calculateWuCaiEffectGroup(result, rule) {
  //   const keHu = rule.ro.kehu || []
  //   const specialTimes = (t) => t
  //
  //   const propertiesAndTimes = rule.useCaiShen ? [] : [
  //     {prop: 'pengPengHu', times: 2},
