      }
      if (this.huRecur(countMap, true, caiCount - 2, lastTakeCardAndCaiShen, result, allSearch)) {
        return true;             //   如果剩余的牌组合成功，和牌
      }
      result.caiShenTou = false
      result.wuCai = true
      result.baoTou = false
