  //
  //   if (hits > 0 && result.wuCai) {
  //     // fan *= specialTimes(2)
  //   }
  //   return fan
  // },

  calculateNormalGroup(result, rule) {
    const keHu = rule.ro.kehu || []
    const specialTimes = (t) => t

    const propertiesAndTimes = this.getPropertiesAndTimes(rule)

    if (result.qiDuiZiBaoTou) {
