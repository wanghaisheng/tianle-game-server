// 保留一个 redis 连接
let redisInstance = null;
export function createClient(): AsyncRedisClient {
  if (redisInstance && redisInstance.connected) {
    // 未断开
    return redisInstance;
  }
  // 已断开,重新连接
  redisInstance = redis.createClient(config.redis);
  return redisInstance as any;
}

