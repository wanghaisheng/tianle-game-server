    events[Enums.anGang] && events[Enums.anGang].forEach(x => {
      if (checkQingYiSe && x == Enums.bai) x = caiShen[0]
      recordSe(x);
    });

    if (detectFeng == feng) {
      return false;
    }

    let se = 0;
    type0 && (se++);
    type1 && (se++);
    type2 && (se++);

    return se === 1;
  }
