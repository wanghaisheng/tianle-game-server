    }

    if (caiCount === 3) {
      keZi.push(CAISHEN_HOLDER)
      result.sanCaiYiKe = true
      result.wuCai = false
      if (this.huRecur(countMap, jiang, caiCount - 3, lastTakeCardAndCaiShen, result, allSearch)) {
        return true;             //   如果剩余的牌组合成功，和牌
      }
